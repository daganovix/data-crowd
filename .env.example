# Copy this to server/.env and fill in the values

# Database — Railway provides this automatically when you add a Postgres plugin
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# Server port (Railway sets this automatically)
PORT=3001

# Anthropic API key — for AI photo analysis
ANTHROPIC_API_KEY="sk-ant-..."

# PayPal (sandbox for testing, live for production)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# Local dev only — not needed in Railway (Railway serves everything on one URL)
VITE_APP_URL="http://localhost:5173"
